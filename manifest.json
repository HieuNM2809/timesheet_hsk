{
  "manifest_version": 3,
  "name": "Đăng nhập và Tính Giờ Làm Việc",
  "version": "1.0",
  "description": "Extension lấy token từ cookie (wshr-token) và tính giờ làm việc.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "checkin.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://wshr.hasaki.vn/",
    "https://work.hasaki.vn/*",
    "https://chat.hasaki.vn/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chat_icon",
        "enabled": true,
        "path": "rules_chat_icon.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["chat-icon-192.png", "chat-icon-512.png"],
      "matches": ["https://chat.hasaki.vn/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://work.hasaki.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://test.hasakiexpress.vn/*",
        "https://hasakiexpress.vn/*",
        "https://chat.hasaki.vn/*"
      ],
      "js": ["snow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.hasaki.vn/*"],
      "js": ["chat.js", "chat-quick-reply.js", "chat-bookmark-sort.js"],
      "css": ["chat-theme.css", "chat-avatar-hover.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://webadmin.system.local/*"],
      "js": ["webadmin.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.hasaki.vn/*"],
      "js": ["chat-mark-all-read.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.hasaki.vn/*"],
      "js": ["chat-dblclick-tick.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
